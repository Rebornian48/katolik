{
  "name": "peta-paroki",
  "version": "2.0.0",
  "description": "Peta Interaktif Paroki & Gereja Katolik Seluruh Indonesia - dengan SQLite, Admin CRUD, dan Radius Search",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node db/init.js",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/init.js --reset && node db/seed.js",
    "scrape:jadwalmisa": "node scripts/scrape-jadwalmisa.js",
    "scrape:ekatolik": "node scripts/scrape-ekatolik.js",
    "scrape:imankatolik": "node scripts/scrape-imankatolik.js",
    "locations:export": "node scripts/locations-export.js",
    "locations:import": "node scripts/locations-import.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "better-sqlite3-session-store": "^0.1.0",
    "cheerio": "^1.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "keywords": [
    "peta",
    "paroki",
    "leaflet",
    "sqlite",
    "keuskupan-agung-semarang",
    "kas",
    "indonesia"
  ],
  "author": "",
  "license": "MIT"
}
